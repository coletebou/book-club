# Template for deploy/livekit/livekit.yaml (D159): voice channels and listening together
# (D153-D158). Generated by deploy/livekit/generate-config.sh from deploy/.env; never edit the
# generated livekit.yaml by hand (it is .gitignored). docs/DEPLOY.md, "Voice and listening
# together" explains every setting and which host ports must be open.
port: 7880
bind_addresses:
  - "0.0.0.0"
rtc:
  tcp_port: 7881
  # One UDP port (a mux), not a range (D159): simpler to open on a shared host's firewall than the
  # thousand-port ranges older WebRTC guides ask for, and LiveKit's own recommendation short of a
  # cluster serving thousands of concurrent calls at once (nowhere near a book club).
  udp_port: ${LIVEKIT_UDP_PORT}
  use_external_ip: true
  # The host's public IP, so ICE candidates it hands out are reachable from the internet (D159).
  node_ip: ${LIVEKIT_NODE_IP}
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
webhook:
  urls:
    - ${LIVEKIT_WEBHOOK_URL}
  api_key: ${LIVEKIT_API_KEY}
logging:
  level: info
  json: false
