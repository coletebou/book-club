# Copy to deploy/.env and fill in.
# The address friends will use (its DNS A/AAAA record must point at this host, ports 80 and 443 open).
BOOKCLUB_HOST=books.example.org
# An e-mail for Let's Encrypt's notices, or "internal" to use Caddy's own certificate authority.
BOOKCLUB_TLS=you@example.org
# Only behind the host's own web server (compose.host-proxy.yaml): the loopback port it proxies to.
# Below 32768, out of the range the kernel lends to outgoing connections, one of which can hold it.
BOOKCLUB_APP_PORT=3110
# A secret the proxy sends with every request, without which the app does not believe its
# X-Forwarded-* headers: needed behind the host's own web server, wise wherever other people have
# accounts on the host (they reach the app from the proxy's address). 32 characters or more:
# openssl rand -base64 32. Caddy sends it by itself; nginx from a file (docs/DEPLOY.md).
BOOKCLUB_TRUST_PROXY_KEY=
# Where the daily backups go on this host, and how many to keep.
BOOKCLUB_BACKUPS=./backups
BOOKCLUB_BACKUP_KEEP=14
# Reading along (docs/RUNBOOK.md): the image carries a speech recogniser (faster-whisper, base.en)
# that transcribes each new audiobook on this host, so that it is lined up with the book sentence
# by sentence. To leave it out of the image (and transcribe nothing), set this empty:
#BOOKCLUB_TRANSCRIBER_MODEL=
# The threads it uses (2 suits a host of 2 to 4 vCPUs; it runs at the lowest priority):
#BOOKCLUB_TRANSCRIBER_THREADS=2
# Or keep it in the image and run another command, or none (empty), instead of the image's:
#BOOKCLUB_TRANSCRIBE_COMMAND=
# A GPU recogniser to hand runs to when it answers (docs/GPU-TRANSCRIPTION.md); this host's runs
# when it does not. Both or neither.
#BOOKCLUB_TRANSCRIBE_REMOTE_URL=http://host.docker.internal:8790
#BOOKCLUB_TRANSCRIBE_REMOTE_TOKEN=
# Optional: friends with an account at an upstream identity provider continue with it, through the
# upstream's app sign-in grant (docs/DEPLOY.md, "One identity"). The upstream sends its codes only to
# the callback it has registered for this host (https://<BOOKCLUB_HOST>/api/auth/upstream/callback);
# both addresses or neither.
#BOOKCLUB_UPSTREAM_START_URL=https://id.example.com/api/auth/book-club/start
#BOOKCLUB_UPSTREAM_EXCHANGE_URL=https://id.example.com/api/auth/book-club/exchange
# Optional on top of the two above: the upstream password typed into this app's own sign-in form,
# instead of a trip to the upstream's own page (docs/DEPLOY.md, "One identity"). Leave commented out
# and "Continue with <upstream>" is the only way in with an upstream account. Both lines or neither:
# that endpoint is bearer-gated, so a URL with no secret would only get 401s. Generate the secret
# with openssl rand -hex 32; the upstream needs the identical value in its own matching setting.
#BOOKCLUB_UPSTREAM_PASSWORD_URL=https://id.example.com/api/auth/book-club/password
#BOOKCLUB_UPSTREAM_PASSWORD_SECRET=

# Sign in with Apple and Continue with Google (D178). Apple: the iOS app's bundle id. Google: a
# "Web application" OAuth client whose authorized redirect is exactly BOOKCLUB_GOOGLE_REDIRECT_URI.
#BOOKCLUB_APPLE_AUDIENCES=com.example.bookclub
#BOOKCLUB_GOOGLE_CLIENT_ID=
#BOOKCLUB_GOOGLE_CLIENT_SECRET=
#BOOKCLUB_GOOGLE_REDIRECT_URI=https://books.example.org/api/auth/google/callback
#BOOKCLUB_UPSTREAM_NAME=Example ID

# Voice channels and listening together (D153-D159): self-hosted LiveKit, next to the app on this
# host. Optional — leave every line below commented out and voice is simply absent from the UI.
# To turn it on: fill in every line here, then deploy/livekit/generate-config.sh, then bring the
# stack up with `--profile livekit` added to the `docker compose` command (docs/DEPLOY.md).
#BOOKCLUB_LIVEKIT_API_KEY=                        # openssl rand -hex 16
#BOOKCLUB_LIVEKIT_API_SECRET=                      # openssl rand -base64 32
# This host's public IPv4 (LiveKit hands it to browsers as their ICE candidate): `curl -4 ifconfig.me`.
#BOOKCLUB_LIVEKIT_NODE_IP=
# The browser's own address for the signalling connection: wss://rtc.<BOOKCLUB_HOST>
# (docs/DEPLOY.md's nginx snippet proxies that subdomain to the loopback port below). Give rtc.*
# its own DNS A record at this host's address, and if it is behind Cloudflare, DNS-only (grey
# cloud): Cloudflare's proxy does not carry the UDP media that rides beside this connection.
#BOOKCLUB_LIVEKIT_URL=wss://rtc.books.example.org
# Loopback port nginx proxies rtc.<BOOKCLUB_HOST> to (signalling only: no media touches it).
#BOOKCLUB_LIVEKIT_PORT=7880
# These two carry real-time media and cannot go through nginx: open them on the host's firewall,
# to the whole internet, and nothing else LiveKit uses (docs/DEPLOY.md explains why each is safe).
#BOOKCLUB_LIVEKIT_TCP_PORT=7881
#BOOKCLUB_LIVEKIT_UDP_PORT=7882
# Where LiveKit's own webhook reaches this app (optional backstop, D154): the compose network's
# own address, not published publicly. Leave the default unless the app's service name changes.
#BOOKCLUB_LIVEKIT_WEBHOOK_URL=http://app:8080/api/livekit/webhook
# Who LiveKit runs as: the owner of deploy/livekit/livekit.yaml (whoever ran generate-config.sh).
#BOOKCLUB_LIVEKIT_USER=1000:1000                   # `id -u`:`id -g`

# Optional: push to the iOS app's lock screen (D134; docs/DEPLOY.md, "Push to the iOS app"). All
# four or none; the in-app bell works either way.
#BOOKCLUB_APNS_KEY_ID=
#BOOKCLUB_APNS_TEAM_ID=
#BOOKCLUB_APNS_BUNDLE_ID=com.example.bookclub
# The .p8 key's own contents (PEM), not a path: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#BOOKCLUB_APNS_PRIVATE_KEY=

# Optional: Cal (Callimachus), the club's AI assistant (D160-D169; docs/DEPLOY.md, "Cal"). Hidden
# until an Anthropic key is set; embeddings default to OpenAI, voice to ElevenLabs.
#BOOKCLUB_ANTHROPIC_API_KEY=
#BOOKCLUB_ANTHROPIC_BASE_URL=https://gateway.internal.example/anthropic
#BOOKCLUB_ANTHROPIC_AUTH_MODE=bearer
#BOOKCLUB_ANTHROPIC_TENANT_ID=your-authorized-tenant
# The header the gateway reads that tenant from (the default below; each gateway names its own).
#BOOKCLUB_ANTHROPIC_TENANT_HEADER=x-gateway-tenant
#BOOKCLUB_CAL_MODEL=anthropic.claude-opus-5-5
#BOOKCLUB_CAL_EFFORT=low
#BOOKCLUB_OPENAI_API_KEY=
#BOOKCLUB_ELEVENLABS_API_KEY=
#BOOKCLUB_CAL_MONTHLY_SPEND_CAP_USD=20

# Optional Sol low-effort fallback for the same scoped Mantle gateway (off unless set).
# Requires the primary's explicit bearer auth, tenant and same endpoint origin; web search off.
# BOOKCLUB_CAL_SOL_BASE_URL=https://gateway.internal.example/openai
# BOOKCLUB_CAL_SOL_MODEL=openai.gpt-6.1-sol
# Required spend-accounting estimates, not a claim of current Sol billing prices.
# BOOKCLUB_CAL_SOL_INPUT_USD_PER_MILLION=6
# BOOKCLUB_CAL_SOL_OUTPUT_USD_PER_MILLION=20
