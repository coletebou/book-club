+    BookClubCarPlayConnected = [note.userInfo[@"connected"] boolValue];
+    for (RNCWebViewImpl *view in BookClubWebViews.allObjects) [view bookClubApplyConnection];
+  }];
+}
+
+- (void)bookClubStopCapture
+{
+  if (@available(iOS 15.0, *)) {
+    if (_webView.cameraCaptureState != WKMediaCaptureStateNone) {
+      [_webView setCameraCaptureState:WKMediaCaptureStateNone completionHandler:nil];
+    }
+    if (_webView.microphoneCaptureState != WKMediaCaptureStateNone) {
+      [_webView setMicrophoneCaptureState:WKMediaCaptureStateNone completionHandler:nil];
+    }
+  }
+}
+
+- (void)bookClubApplyConnection
+{
+  if (!_webView) return;
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 180400
+  if (@available(iOS 18.4, *)) {
+    // WebKit caches the delegate's selectors. Only override Apple's picker while capture is blocked.
+    _webView.UIDelegate = nil;
+    _webView.UIDelegate = self;
+  }
+#endif
+  NSString *value = BookClubCarPlayConnected ? @"true" : @"false";
+  NSString *script = [NSString stringWithFormat:
+    @"(function(){var n=window.BookClubNative;if(n&&n.carPlayConnected!==%@){n.carPlayConnected=%@;window.dispatchEvent(new Event('bookclub:carplay-connection'));}})()",
+    value, value];
+  [_webView evaluateJavaScript:script completionHandler:nil];
+  if (!BookClubCarPlayConnected) return;
+
+  [self bookClubStopCapture];
+  BookClubDismissMenus(_webView);
+  // WebKit presents a public UIImagePickerController for camera input. Cancel the upload request.
+  for (UIViewController *shown = self.window.rootViewController; shown; shown = shown.presentedViewController) {
+    if (![shown isKindOfClass:UIImagePickerController.class]) continue;
+    UIImagePickerController *picker = (UIImagePickerController *)shown;
+    if (picker.sourceType != UIImagePickerControllerSourceTypeCamera) continue;
+    if ([picker.delegate respondsToSelector:@selector(imagePickerControllerDidCancel:)]) {
+      [picker.delegate imagePickerControllerDidCancel:picker];
+    } else {
+      [picker dismissViewControllerAnimated:NO completion:nil];
+    }
+    break;
+  }
+}
