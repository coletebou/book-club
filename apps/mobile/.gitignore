# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by `expo prebuild`; scripts/prebuild.sh regenerates, never hand-edited)
/ios
/android
# written into targets/ by @bacons/apple-targets at prebuild (the Info.plist, the colours from
# expo-target.config.js); the config and the Swift are the source
/targets/*/Info.plist
/targets/*/Assets.xcassets/*.colorset/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# the App Store Connect key, copied to the Mac EC2 for scripts/archive.sh and deleted after
private/

# build output (xcodebuild archives, .ipa exports)
build/
