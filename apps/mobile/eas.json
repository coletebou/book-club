{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "development",
      "env": {
        "BOOKCLUB_UPDATE_CHANNEL": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "BOOKCLUB_APS_ENVIRONMENT": "production",
        "BOOKCLUB_UPDATE_CHANNEL": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": {
        "BOOKCLUB_APS_ENVIRONMENT": "production",
        "BOOKCLUB_UPDATE_CHANNEL": "production"
      },
      "node": "24.11.0",
      "pnpm": "11.18.0"
    }
  }
}
